.ranking {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.small {
  font-size: 58rpx;
}

.tabs {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14rpx;
  width: 100%;
  min-width: 0;
  box-sizing: border-box;
}

.tabs .secondary-button {
  min-height: 76rpx;
  padding: 12rpx 8rpx;
  font-size: 28rpx;
}

.tabs .active {
  color: #fff;
  background: #111;
}

.empty {
  padding: 40rpx;
  font-size: 34rpx;
  font-weight: 900;
}

.rank-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding: 24rpx;
}

.rank-left {
  display: flex;
  align-items: center;
  gap: 18rpx;
  min-width: 0;
}

.rank {
  flex: 0 0 76rpx;
  font-size: 36rpx;
  font-weight: 900;
}

.rank-avatar {
  flex: 0 0 auto;
  width: 72rpx;
  height: 72rpx;
  border: 4rpx solid #111;
  border-radius: 50%;
  background: #f7d84a;
}

.fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 900;
}

.info {
  flex: 1 1 auto;
  min-width: 0;
}

.name {
  font-size: 32rpx;
  font-weight: 900;
  word-break: break-all;
}

.meta {
  margin-top: 8rpx;
  font-size: 24rpx;
  font-weight: 800;
}

.best-score {
  flex: 0 0 134rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 98rpx;
  padding: 8rpx 10rpx;
  border: 6rpx solid #111;
  border-radius: 8rpx;
  box-sizing: border-box;
  background: #e33124;
  color: #fff;
  box-shadow: 6rpx 6rpx 0 #111;
}

.best-number {
  font-size: 48rpx;
  font-weight: 900;
  line-height: 1;
}

.best-label {
  margin-top: 8rpx;
  font-size: 20rpx;
  font-weight: 900;
  line-height: 1;
}
