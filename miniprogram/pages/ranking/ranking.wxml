<view class="page ranking">
  <view class="brand small">谁最能装</view>

  <view wx:if="{{boards.length > 1}}" class="tabs">
    <button wx:for="{{boards}}" wx:key="type" class="secondary-button {{type === item.type ? 'active' : ''}}" data-type="{{item.type}}" bindtap="switchType">{{item.label}}</button>
  </view>

  <view wx:if="{{items.length === 0}}" class="empty comic-panel">排行榜还没人装起来。</view>

  <view wx:for="{{items}}" wx:key="rank" class="rank-item comic-panel {{item.isMe ? 'is-me' : ''}}">
    <view class="rank-left">
      <view class="rank">#{{item.rank}}</view>
      <image wx:if="{{item.user.profileAuthorized && item.user.avatarUrl}}" class="rank-avatar" src="{{item.user.avatarUrl}}" mode="aspectFill"></image>
      <view wx:else class="rank-avatar fallback">{{item.user.initial || '名'}}</view>
      <view class="info">
        <view class="name">{{item.user.nickname}}<text wx:if="{{item.isMe}}" class="me-badge">我</text></view>
        <view class="meta">{{item.user.title}} · 胜 {{item.user.wins}}</view>
      </view>
    </view>
    <view class="best-score">
      <view class="best-number">{{item.value}}</view>
      <view class="best-label">{{valueLabel}}</view>
    </view>
  </view>
</view>
