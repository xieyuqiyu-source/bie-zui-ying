.battle {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  box-sizing: border-box;
  padding: 46rpx 32rpx;
  background: #e33124;
  color: #fff;
}

.top {
  text-align: center;
}

.time {
  display: inline-flex;
  min-width: 180rpx;
  justify-content: center;
  padding: 14rpx 24rpx;
  border: 6rpx solid #111;
  border-radius: 8rpx;
  background: #f7d84a;
  color: #111;
  font-size: 36rpx;
  font-weight: 900;
}

.live-status {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  max-width: 100%;
  margin-top: 18rpx;
  padding: 8rpx 18rpx;
  border: 4rpx solid #111;
  border-radius: 999rpx;
  box-sizing: border-box;
  background: #fff;
  color: #111;
  font-size: 24rpx;
  font-weight: 900;
}

.live-dot {
  width: 16rpx;
  height: 16rpx;
  margin-right: 10rpx;
  border: 3rpx solid #111;
  border-radius: 50%;
  box-sizing: border-box;
  background: #999;
}

.live-status.is-online .live-dot {
  background: #29d35b;
}

.score-board {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 72rpx minmax(0, 1fr);
  align-items: stretch;
  gap: 14rpx;
  width: 100%;
  margin-top: 28rpx;
}

.score-card {
  min-width: 0;
  padding: 18rpx 12rpx 20rpx;
  border: 6rpx solid #111;
  border-radius: 8rpx;
  box-sizing: border-box;
  color: #111;
  background: #fff;
  box-shadow: 7rpx 7rpx 0 #111;
}

.score-card.mine {
  background: #f7d84a;
}

.score-card.rival {
  background: #fff;
}

.score-label {
  min-width: 0;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 1.2;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.score-number {
  margin-top: 8rpx;
  font-size: 92rpx;
  font-weight: 900;
  line-height: 1;
  text-shadow: 5rpx 5rpx 0 #e33124;
}

.score-card.mine .score-number {
  text-shadow: 5rpx 5rpx 0 #fff;
}

.score-vs {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 0;
  height: 72rpx;
  align-self: center;
  border: 5rpx solid #111;
  border-radius: 50%;
  box-sizing: border-box;
  background: #111;
  color: #fff;
  font-size: 24rpx;
  font-weight: 900;
}

.hint {
  margin-top: 18rpx;
  font-size: 30rpx;
  font-weight: 900;
}

.tap-zone {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin-top: 36rpx;
  border: 8rpx solid #111;
  border-radius: 8rpx;
  background: #fff;
  color: #111;
  box-shadow: 10rpx 10rpx 0 #111;
}

.tap-zone.is-finished {
  background: #f7d84a;
}

.tap-main {
  font-size: 72rpx;
  font-weight: 900;
}

.tap-sub {
  margin-top: 16rpx;
  font-size: 30rpx;
  font-weight: 800;
}

.result-delay {
  max-width: 86%;
  margin-top: 24rpx;
  padding: 12rpx 18rpx;
  border: 5rpx solid #111;
  border-radius: 8rpx;
  box-sizing: border-box;
  background: #fff;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1.25;
  text-align: center;
  word-break: break-all;
  overflow-wrap: anywhere;
}
