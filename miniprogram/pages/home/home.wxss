.home {
  display: flex;
  flex-direction: column;
  gap: 34rpx;
}

.status {
  padding: 28rpx;
}

.nickname {
  margin-top: 18rpx;
  font-size: 42rpx;
  font-weight: 900;
}

.stats {
  margin-top: 10rpx;
  font-size: 28rpx;
  font-weight: 700;
}

.taunt {
  padding: 28rpx;
  border-left: 10rpx solid #111;
  background: rgba(255, 255, 255, 0.56);
  font-size: 36rpx;
  font-weight: 900;
  line-height: 1.35;
}

.start {
  margin-top: 20rpx;
}

.actions {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: 22rpx;
  width: 100%;
  min-width: 0;
  box-sizing: border-box;
}

.actions .secondary-button {
  min-height: 88rpx;
  font-size: 30rpx;
  padding-left: 12rpx;
  padding-right: 12rpx;
  width: 100%;
  max-width: 100%;
  min-width: 0;
}

.fame-mask {
  position: fixed;
  z-index: 20;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  box-sizing: border-box;
  background: rgba(0, 0, 0, 0.55);
}

.fame-panel {
  width: 100%;
  max-height: 88vh;
  padding: 32rpx;
  box-sizing: border-box;
  overflow-y: auto;
}

.fame-title {
  font-size: 42rpx;
  font-weight: 900;
  line-height: 1.2;
}

.fame-copy {
  margin-top: 18rpx;
  margin-bottom: 26rpx;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.4;
}

.fame-profile-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 24rpx;
  width: 100%;
  min-width: 0;
  box-sizing: border-box;
}

.avatar-shell {
  flex: 0 0 132rpx;
  width: 132rpx;
  height: 132rpx;
  border: 6rpx solid #111;
  border-radius: 50%;
  box-sizing: border-box;
  box-shadow: 6rpx 6rpx 0 #111;
  overflow: hidden;
  background: #fff;
}

.avatar-picker {
  width: 120rpx;
  height: 120rpx;
  min-height: 120rpx;
  padding: 0;
  border: 0;
  border-radius: 50%;
  box-shadow: none;
  background: transparent;
}

.avatar-preview,
.avatar-face {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
}

.avatar-face {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #111;
  font-size: 54rpx;
  font-weight: 900;
}

.face-red {
  background: #e33124;
  color: #fff;
}

.face-yellow {
  background: #f7d84a;
}

.face-blue {
  background: #54a3ff;
}

.face-green {
  background: #55d17a;
}

.face-pink {
  background: #ff8fb1;
}

.face-gray {
  background: #e7e7e7;
}

.fame-input {
  flex: 1 1 auto;
  min-width: 0;
  height: 92rpx;
  padding: 0 22rpx;
  border: 6rpx solid #111;
  border-radius: 8rpx;
  box-sizing: border-box;
  background: #fff;
  font-size: 32rpx;
  font-weight: 900;
}
