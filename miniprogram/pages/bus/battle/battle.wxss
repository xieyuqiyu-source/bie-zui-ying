.bus-battle {
  display: flex;
  flex-direction: column;
  height: 100vh;
  overflow: hidden;
  background: #e9dcc0;
}

.hud {
  flex: 0 0 auto;
  padding: 20rpx 32rpx 12rpx;
  background: #fff3c4;
  border-bottom: 6rpx solid #111;
}

.hud-panel {
  padding: 18rpx 24rpx 20rpx;
  border: 6rpx solid #111;
  border-radius: 8rpx;
  background: #1f5a4a;
  color: #fff;
  box-shadow: 8rpx 8rpx 0 #111;
}

.hud-title {
  font-size: 26rpx;
  font-weight: 900;
  text-align: center;
}

.hud-row {
  display: flex;
  align-items: center;
  margin-top: 8rpx;
}

.hud-cell {
  flex: 1;
  text-align: center;
}

.hud-num {
  font-size: 52rpx;
  font-weight: 900;
  line-height: 1.1;
  color: #f7c531;
}

.hud-label {
  font-size: 22rpx;
  font-weight: 800;
}

.hud-divider {
  width: 4rpx;
  height: 72rpx;
  background: rgba(255, 255, 255, 0.4);
}

.hud-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-top: 16rpx;
}

.live {
  display: inline-flex;
  align-items: center;
  min-width: 0;
  padding: 6rpx 16rpx;
  border: 4rpx solid #111;
  border-radius: 999rpx;
  background: #fff;
  font-size: 22rpx;
  font-weight: 900;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.live-dot {
  flex: 0 0 auto;
  width: 14rpx;
  height: 14rpx;
  margin-right: 8rpx;
  border: 3rpx solid #111;
  border-radius: 50%;
  background: #999;
}

.live.is-online .live-dot {
  background: #29d35b;
}

.scene {
  flex: 1 1 auto;
  width: 100%;
  min-height: 0;
}

.hint {
  margin-top: 12rpx;
  font-size: 30rpx;
  font-weight: 900;
  text-align: center;
}

.hint.is-bad {
  color: #e33124;
}

.feet {
  flex: 0 0 auto;
  padding: 24rpx 32rpx 56rpx;
  border-top: 6rpx solid #111;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 28rpx;
}

.foot {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 280rpx;
  border: 6rpx solid #111;
  border-radius: 8rpx;
  background: #fff;
  box-shadow: 10rpx 10rpx 0 #111;
}

.foot.is-next {
  background: #f7c531;
}

.foot:active {
  transform: translate(6rpx, 6rpx);
  box-shadow: 4rpx 4rpx 0 #111;
}

.foot-sole {
  width: 70rpx;
  height: 120rpx;
  border: 6rpx solid #111;
  border-radius: 40rpx 40rpx 30rpx 30rpx;
  background: repeating-linear-gradient(180deg, #1f5a4a 0 16rpx, #fff 16rpx 26rpx);
}

.foot-label {
  margin-top: 18rpx;
  font-size: 36rpx;
  font-weight: 900;
}
