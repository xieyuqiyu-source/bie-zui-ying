.bus-result {
  display: flex;
  flex-direction: column;
  gap: 30rpx;
}

.small {
  font-size: 58rpx;
}

.trash {
  padding: 34rpx;
  font-size: 42rpx;
  font-weight: 900;
  line-height: 1.3;
}

.score-card {
  padding: 28rpx;
}

.line {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  padding: 18rpx 0;
  border-bottom: 4rpx solid #111;
  font-size: 34rpx;
  font-weight: 900;
}

.line:last-child {
  border-bottom: 0;
}

.presence {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 24rpx;
}

.presence-dot {
  flex: 0 0 30rpx;
  width: 30rpx;
  height: 30rpx;
  border: 5rpx solid #111;
  border-radius: 50%;
  box-sizing: border-box;
  background: #999;
}

.presence-dot.is-online {
  background: #29d35b;
}

.presence-copy {
  flex: 1 1 auto;
  min-width: 0;
}

.presence-title {
  font-size: 32rpx;
  font-weight: 900;
  line-height: 1.2;
  word-break: break-all;
  overflow-wrap: anywhere;
}

.presence-sub {
  margin-top: 8rpx;
  color: #555;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.3;
}

.is-win {
  color: #1f5a4a;
}

.verdict {
  margin-top: -12rpx;
  font-size: 32rpx;
  font-weight: 900;
}

.who {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
}

.who-name {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.role-tag {
  flex: 0 0 auto;
  background: #f7c531;
}
