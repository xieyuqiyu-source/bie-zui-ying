.coffin-lobby {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

.taunt {
  padding: 24rpx 28rpx;
  border-left: 10rpx solid #5b3a29;
  background: rgba(255, 255, 255, 0.56);
  font-size: 32rpx;
  font-weight: 900;
  line-height: 1.35;
}

.section-title {
  font-size: 34rpx;
  font-weight: 900;
}

.roles {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
}

.role {
  padding: 24rpx 20rpx;
  text-align: center;
}

.role.is-active {
  background: #e8c99a;
  border-color: #5b3a29;
  box-shadow: 10rpx 10rpx 0 #5b3a29;
}

.role-glyph {
  width: 96rpx;
  height: 96rpx;
  margin: 0 auto;
  border: 6rpx solid #111;
  border-radius: 8rpx;
  background: #5b3a29;
  color: #fff;
  font-size: 52rpx;
  font-weight: 900;
  line-height: 96rpx;
}

.role-name {
  margin-top: 14rpx;
  font-size: 36rpx;
  font-weight: 900;
}

.role-copy {
  margin-top: 10rpx;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.4;
  text-align: left;
}

.role-note {
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.4;
}
