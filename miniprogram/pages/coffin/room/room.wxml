<view class="page coffin-room">
  <view class="brand small">灵堂集合</view>
  <view class="subtitle">{{statusText}}</view>

  <view class="players">
    <view class="player comic-panel">
      <view class="online-row">
        <view class="online-dot {{ownerOnline ? 'on' : ''}}"></view>
        <text>{{ownerOnline ? '在线' : '连接中'}}</text>
      </view>
      <view class="avatar">{{ownerInitial}}</view>
      <view class="name">{{room.ownerUser.nickname || '房主'}}</view>
      <view class="tag role-tag">{{ownerRole}}</view>
      <view class="ready">{{room.owner.ready ? '已准备' : '还没准备'}}</view>
    </view>
    <view class="versus">搭档</view>
    <view class="player comic-panel">
      <view class="online-row">
        <view class="online-dot {{guestOnline ? 'on' : ''}}"></view>
        <text>{{guestOnline ? '在线' : '等兄弟'}}</text>
      </view>
      <view class="avatar">{{guestInitial}}</view>
      <view class="name">{{room.guestUser.nickname || '等待兄弟'}}</view>
      <view class="tag role-tag">{{guestRole}}</view>
      <view class="ready">{{room.guest && room.guest.ready ? '已准备' : '还没到'}}</view>
    </view>
  </view>

  <button class="primary-button" bindtap="ready" loading="{{loading}}">我准备好了</button>
  <button class="secondary-button" open-type="share">叫兄弟来抬</button>
</view>
