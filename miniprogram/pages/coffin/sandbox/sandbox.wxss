.sandbox {
  position: relative;
  display: flex;
  flex-direction: column;
  height: 100vh;
  overflow: hidden;
  background: #f7d84a;
}

.hud {
  position: absolute;
  top: 20rpx;
  left: 32rpx;
  right: 32rpx;
  z-index: 2;
}

.hud-panel {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 24rpx;
  border: 6rpx solid #111;
  border-radius: 8rpx;
  background: #fff;
  box-shadow: 8rpx 8rpx 0 #111;
}

.hud-time {
  font-size: 48rpx;
  font-weight: 900;
}

.hud-status {
  font-size: 28rpx;
  font-weight: 800;
}

.scene {
  flex: 1;
  width: 100%;
  border-bottom: 6rpx solid #111;
}

.controls {
  display: flex;
  padding: 20rpx 20rpx 40rpx;
}

.side {
  flex: 1;
  padding: 0 12rpx;
}

.side-label {
  margin-bottom: 12rpx;
  padding: 8rpx 0;
  border: 4rpx solid #111;
  border-radius: 8rpx;
  color: #fff;
  font-size: 26rpx;
  font-weight: 900;
  text-align: center;
}

.pose-button {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 92rpx;
  margin-bottom: 14rpx;
  border: 6rpx solid #111;
  border-radius: 8rpx;
  background: #fff;
  box-shadow: 6rpx 6rpx 0 #111;
  font-size: 32rpx;
  font-weight: 900;
}

.pose-button.is-active {
  background: #111;
  color: #f7d84a;
  box-shadow: none;
  transform: translate(6rpx, 6rpx);
}

.result-mask {
  position: absolute;
  inset: 0;
  z-index: 5;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 48rpx;
  background: rgba(17, 17, 17, 0.55);
}

.result-card {
  width: 100%;
  padding: 40rpx 32rpx;
  box-sizing: border-box;
}

.result-title {
  font-size: 56rpx;
  font-weight: 900;
  text-align: center;
}

.result-text {
  margin: 20rpx 0 32rpx;
  font-size: 30rpx;
  font-weight: 700;
  text-align: center;
}
