<view class="page result">
  <view class="brand small">{{headline}}</view>
  <view class="trash comic-panel">{{trashTalk}}</view>

  <view class="score-card comic-panel">
    <view class="line">
      <text>{{ownerName}}</text>
      <text>{{ownerScore}}</text>
    </view>
    <view class="line">
      <text>{{guestName}}</text>
      <text>{{guestScore}}</text>
    </view>
  </view>

  <button class="primary-button" bindtap="goRanking">看看谁在装</button>
  <button class="secondary-button" bindtap="goHome">再开一局</button>
  <button class="secondary-button" bindtap="openFameModal">留下赫赫威名</button>

  <view wx:if="{{fameModalVisible}}" class="fame-mask">
    <view class="fame-panel comic-panel">
      <view class="fame-title">这局有点东西，要不要带名上榜？</view>
      <view class="fame-copy">授权后会出现在排行榜。不授权也能继续嘴硬。</view>
      <view class="fame-profile-row">
        <view class="avatar-shell">
          <button class="avatar-picker" open-type="chooseAvatar" bindchooseavatar="chooseAvatar">
            <image wx:if="{{fameAvatarTemp || user.avatarUrl}}" class="avatar-preview" src="{{fameAvatarTemp || user.avatarUrl}}" mode="aspectFill"></image>
            <view wx:else class="avatar-face face-{{fameDefaultAvatar.theme}}">{{fameDefaultAvatar.text}}</view>
          </button>
        </view>
        <input class="fame-input" type="nickname" maxlength="32" value="{{fameNickname}}" placeholder="输入你的响亮名号" bindinput="inputFameNickname" />
      </view>
      <button class="primary-button" loading="{{savingProfile}}" bindtap="saveProfile">留下赫赫威名</button>
      <button class="secondary-button" bindtap="closeFameModal">匿名也很帅</button>
    </view>
  </view>
</view>
