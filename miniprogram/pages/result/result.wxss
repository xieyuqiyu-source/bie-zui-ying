.result {
  display: flex;
  flex-direction: column;
  gap: 30rpx;
}

.small {
  font-size: 58rpx;
}

.trash {
  padding: 34rpx;
  font-size: 42rpx;
  font-weight: 900;
  line-height: 1.3;
}

.score-card {
  padding: 28rpx;
}

.line {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  padding: 18rpx 0;
  border-bottom: 4rpx solid #111;
  font-size: 34rpx;
  font-weight: 900;
}

.line:last-child {
  border-bottom: 0;
}

